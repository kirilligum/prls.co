---
---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css';

const { frontmatter = {}, pageTitle = frontmatter.title } = Astro.props; // Use frontmatter.title as default pageTitle
const isBlogPage = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname.length > '/blog/'.length; // True only for individual posts

// Helper to format date
function formatDate(dateStr: string | Date) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[isBlogPage ? 'blog-active blog-post-active' : (Astro.url.pathname.startsWith('/blog') ? 'blog-active' : '')]}>
    <Header title={pageTitle} />
    {isBlogPage ? (
      <main class="blog-post-content">
        <article>
          <header class="post-header-container">
            <h1>{frontmatter.title}</h1>
            <p class="post-meta">
              {frontmatter.author && <span class="author">By {frontmatter.author}</span>}
              {frontmatter.date && <time datetime={frontmatter.date.toISOString ? frontmatter.date.toISOString() : frontmatter.date}>{formatDate(frontmatter.date)}</time>}
            </p>
            {frontmatter.description && <p class="post-lede">{frontmatter.description}</p>}
          </header>
          <div class="post-body">
            <slot />
          </div>
        </article>
      </main>
    ) : (
      <slot />
    )}
    <Footer />
  </body>
</html>
