---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css';

const { frontmatter = {}, pageTitle = frontmatter.title } = Astro.props;
const currentPath = Astro.url.pathname;

const isIndividualPost = currentPath.startsWith('/blog/') && currentPath.length > '/blog/'.length;
const isBlogPath = currentPath.startsWith('/blog');

let bodyClasses = [];
if (isBlogPath) {
  bodyClasses.push('blog-active');
}
if (isIndividualPost) {
  bodyClasses.push('blog-post-active');
}

// Helper to format date
function formatDate(dateStr: string | Date) {
  if (!dateStr) return '';
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

let datetimeAttrValue = '';
if (frontmatter.date) {
  if (typeof frontmatter.date.toISOString === 'function') {
    datetimeAttrValue = frontmatter.date.toISOString();
  } else {
    datetimeAttrValue = String(frontmatter.date); // Assume it's a pre-formatted string or convert
  }
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={bodyClasses}>
    <Header title={pageTitle} />
    {isIndividualPost ? (
      <main class="blog-post-content">
        <article>
          <header class="post-header-container">
            <h1>{frontmatter.title}</h1>
            <p class="post-meta">
              {frontmatter.author && <span class="author">By {frontmatter.author}</span>}
              {frontmatter.date && <time datetime={datetimeAttrValue}>{formatDate(frontmatter.date)}</time>}
            </p>
            {frontmatter.description && <p class="post-lede">{frontmatter.description}</p>}
          </header>
          <div class="post-body">
            <slot />
          </div>
        </article>
      </main>
    ) : (
      <slot />
    )}
    <Footer />
  </body>
</html>
