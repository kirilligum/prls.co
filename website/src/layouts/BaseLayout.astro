---
import Layout from "./Layout.astro"; // Use the main Layout
import "../styles/blog.css"; // Keep blog-specific styles tied here

const { frontmatter = {}, pageTitle = frontmatter.title } = Astro.props;

// Helper to format date (remains as it's specific to formatting post dates)
function formatDate(dateStr: string | Date) {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

let datetimeAttrValue = "";
if (frontmatter.date) {
  if (typeof frontmatter.date.toISOString === "function") {
    datetimeAttrValue = frontmatter.date.toISOString();
  } else {
    datetimeAttrValue = String(frontmatter.date); // Assume it's a pre-formatted string or convert
  }
}
---

<Layout title={pageTitle}>
  <main class="blog-post-content">
    <article>
      <header class="post-header-container">
        <h1>{frontmatter.title}</h1>
        <p class="post-meta">
          {frontmatter.author && (
            <span class="author">By {frontmatter.author}</span>
          )}
          {frontmatter.date && (
            <time datetime={datetimeAttrValue}>
              {formatDate(frontmatter.date)}
            </time>
          )}
        </p>
        {frontmatter.description && (
          <p class="post-lede">{frontmatter.description}</p>
        )}
      </header>
      <div class="post-body">
        <slot /> {/* This slot is for the Markdown content */}
      </div>
    </article>
  </main>
</Layout>
