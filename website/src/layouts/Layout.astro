---
interface Props {
  title: string;
}

import ColorControls from "../components/ColorControls.astro";
import Header from "../components/Header.astro";

const { title = "Pearls of Wisdom - SEO for LLMs" } = Astro.props;
const isBlogPage = Astro.url.pathname.startsWith('/blog');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Questrial&family=Spectral:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <meta
      name="description"
      content="We make ChatGPT and Google's AI Overview champion your company FIRST, OFTEN and ACCURATELY."
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <header>
    <Header isBlogPage={isBlogPage}>
      <a href="/blog" id="blog-link">Blog</a>
    </Header>
  </header>
  <ColorControls />
  <body class:list={[isBlogPage ? 'blog-active' : '']}>
    <slot />
  </body>
  <footer style="background-color: var(--prls-main-surface-primary);">
    <p>
      &copy; 2024 Pearls of Wisdom | <a href="prls_co/1.html">AI Knowledge</a>
    </p>
  </footer>

  <style is:global>
    :root {
      /* Colors */
      --hf-color: #4d4d4d;
      --hf-bg-color: #ebf5f7;
      --prls-main-surface-primary: #f7f5f2;
      --prls-main-surface-secondary: #e6d9ce;
      --prls-text-primary: #3d3d3d;
      --prls-text-secondary: #5d5d5d;
      --prls-text-tertiary: #b4b4b4;
      --hero-gradient-start: #f2e6de;

      /* Typography */
      --font-heading: "Libre Baskerville", serif;
      --font-body: "Questrial", sans-serif; /* Reverted to default */
      --font-weight-bold: 700;
      --line-height-body: 1.6; /* Reverted to default */
      --text-lg: 1.2em;
    }

    #blog-link {
      color: var(--hf-color);
      text-decoration: none;
      font-size: 1rem; /* Adjust as needed */
      padding-right: 1rem; /* Adjust as needed */
    }

    #blog-link:hover {
      text-decoration: underline;
    }

    /* Base styles */
    html {
      font-family: var(--font-body); /* Uses default Questrial */
      color: var(--prls-text-primary); /* Default site text color */
      line-height: var(--line-height-body); /* Default 1.6 */
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--prls-main-surface-primary); /* Default site background */
    }

    /* Overrides for specific links outside main blog content (e.g., header, footer) */
    #blog-link, /* Header blog link */
    #blog-link:hover {
      border-bottom: none; /* Remove blog-style border from header link */
      /* color and text-decoration are already handled by its own existing specific rule */
    }

    footer a { /* Links within the footer */
      color: var(--hf-color); /* Match footer text color */
      border-bottom: none; /* Remove blog-style border */
      text-decoration: underline; /* Standard footer link appearance */
    }

    footer a:hover {
      color: var(--hf-color); /* Ensure hover color consistency for footer links */
      /* text-decoration: underline; is inherited from 'footer a' */
    }
    /* End of Blog Content Styles & Overrides */

    footer {
      text-align: center;
      padding: 1rem;
      background-color: var(--prls-main-surface-primary);
      color: var(--hf-color);
      padding-top: 4rem;
    }
  </style>


</html>
