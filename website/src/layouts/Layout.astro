---
interface Props {
  title: string;
}

import ColorControls from "../components/ColorControls.astro";
import Header from "../components/Header.astro";

const { title = "Pearls of Wisdom - SEO for LLMs" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Questrial&family=Spectral:wght@300;400;600&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/icon?family=Material+Icons"
      rel="stylesheet"
    />
    <meta
      name="description"
      content="We make ChatGPT and Google's AI Overview champion your company FIRST, OFTEN and ACCURATELY."
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <header>
    <Header>
      <a href="/blog" id="blog-link">Blog</a>
    </Header>
  </header>
  <ColorControls />
  <body>
    <slot />
  </body>
  <footer style="background-color: var(--prls-main-surface-primary);">
    <p>
      &copy; 2024 Pearls of Wisdom | <a href="prls_co/1.html">AI Knowledge</a>
    </p>
  </footer>

  <style is:global>
    :root {
      /* Colors */
      --hf-color: #4d4d4d;
      --hf-bg-color: #ebf5f7;
      --prls-main-surface-primary: #f7f5f2;
      --prls-main-surface-secondary: #e6d9ce;
      --prls-text-primary: #3d3d3d;
      --prls-text-secondary: #5d5d5d;
      --prls-text-tertiary: #b4b4b4;
      --hero-gradient-start: #f2e6de;

      /* Blog Colors (Medium-like) */
      --blog-bg-color: #fcfcfc; /* Light background */
      --blog-text-color: #333333; /* Dark text */
      --blog-link-color: #1a8917; /* Medium green link color */
      --blog-link-hover-color: #0f5f0d; /* Darker green on hover */


      /* Typography */
      --font-heading: "Libre Baskerville", serif;
      --font-body: "Spectral", serif; /* Changed to serif */
      --font-weight-bold: 700;
      --line-height-body: 1.8; /* Increased line height */
      --text-lg: 1.2em;
    }

    #blog-link {
      color: var(--hf-color);
      text-decoration: none;
      font-size: 1rem; /* Adjust as needed */
      padding-right: 1rem; /* Adjust as needed */
    }

    #blog-link:hover {
      text-decoration: underline;
    }

    /* Base styles */
    html {
      font-family: var(--font-body);
      color: var(--blog-text-color); /* Use blog text color */
      line-height: var(--line-height-body); /* Use updated line height */
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--blog-bg-color); /* Use blog background color */
    }

    footer {
      text-align: center;
      padding: 1rem;
      background-color: var(--prls-main-surface-primary);
      color: var(--hf-color);
      padding-top: 4rem;
    }
  </style>


</html>
