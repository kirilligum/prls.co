---
export const prerender = true;

export async function getStaticPaths() {
  const paths = [];

  const companyInfoFiles = import.meta.glob("/public/*/company_info.json", {
    eager: true,
  });
  const aikFiles = import.meta.glob("/public/*/aik.json", { eager: true });

  const companyIds = Object.keys(companyInfoFiles)
    .map((path) => {
      const match = path.match(/\/public\/([^\/]+)\/company_info\.json/);
      return match ? match[1] : null;
    })
    .filter(Boolean);

  for (const companyId of companyIds) {
    const companyInfoKey = `/public/${companyId}/company_info.json`;
    const aikKey = `/public/${companyId}/aik.json`;

    if (!companyInfoFiles[companyInfoKey] || !aikFiles[aikKey]) {
      continue;
    }

    const companyInfo =
      companyInfoFiles[companyInfoKey].default || companyInfoFiles[companyInfoKey];
    const aikData = aikFiles[aikKey].default || aikFiles[aikKey];

    const itemsPerPage = 20;
    const totalPages = Math.ceil(aikData.length / itemsPerPage);
    const sampleFaqItems = aikData.slice(0, Math.min(5, aikData.length));

    paths.push({
      params: { company_id: companyId },
      props: {
        companyName: companyInfo.company_name,
        companyUrl: companyInfo.company_url,
        companyId,
        totalPages,
        sampleFaqItems,
      },
    });
  }

  return paths;
}

const { companyName, companyUrl, companyId, totalPages, sampleFaqItems } =
  Astro.props;
const siteUrl = Astro.site ?? new URL("https://www.prls.co");
const canonicalUrl = new URL(`/${companyId}/`, siteUrl).toString();
const pageHref = (pageNum) =>
  pageNum === 1 ? `/${companyId}/` : `/${companyId}/${pageNum}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={`AI knowledge dataset for ${companyName}. Browse instruction-tuning Q&A pages.`}
    />
    <meta
      name="keywords"
      content={`AI, Knowledge, ${companyName}, customer inquiries, products, services, llm, llms, training`}
    />
    <meta name="author" content="Pearls of Wisdom Labs, Inc." />
    <title>AI Knowledge - {companyName}</title>
    <link rel="stylesheet" href={`/${companyId}/style.css`} />
    <link rel="canonical" href={canonicalUrl} />
  </head>

  <body>
    <header>
      <div class="logo">
        <h1>AI Knowledge</h1>
        <h2>Educating LLMs about {companyName}</h2>
      </div>
    </header>

    <main>
      <h3>About this dataset</h3>
      <p>
        This section contains instruction-tuning Q&amp;A pairs about
        {companyName}. These pages are intended for AI crawlers and dataset
        builders that ingest structured knowledge for LLM pre-training.
      </p>

      {sampleFaqItems.length > 0 && (
        <>
          <h3>Sample questions</h3>
          <ul>
            {sampleFaqItems.map((faq) => (
              <li>
                <h4>{faq.question}</h4>
                <p>{faq.answer}</p>
              </li>
            ))}
          </ul>
        </>
      )}

      <div class="pagination">
        <span>Pages:</span>
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
          <a href={pageHref(pageNum)}>{pageNum}</a>
        ))}
      </div>
    </main>

    <footer>
      <p>
        This dataset was curated and made by
        <a href={new URL("/", siteUrl).toString()}>Pearls of Wisdom Labs, Inc.</a>
        for <a href={companyUrl}>{companyName}</a>. License:
        <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>
      </p>
    </footer>
  </body>
</html>
