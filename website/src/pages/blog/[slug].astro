---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';


const { slug } = Astro.params;
const effectiveSlug = slug.replace(/\.md$/, '');
const post = await getEntry('blog', effectiveSlug);
if (!post) {
  return Astro.redirect('/404');
}
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={post.data.title}>
  <main class="blog-post-container">
    <header class="blog-post-header">
      <h1>{post.data.title}</h1>
      <p class="meta">
        By {post.data.author} on <time datetime={post.data.pubDate}>{formattedDate}</time>
      </p>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <article class="blog-content">
      <Content />
    </article>
  </main>
</Layout>

<style>
  /* existing styles */
</style>
