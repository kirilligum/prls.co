---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';


const { slug } = Astro.params;
const effectiveSlug = slug.replace(/\.md$/, '');
const post = await getEntry('blog', effectiveSlug);
if (!post) {
  return Astro.redirect('/404');
}
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={post.data.title}>
  <main class="blog-post-container">
    <header class="blog-post-header">
      <h1>{post.data.title}</h1>
      <p class="meta">
        By {post.data.author} on <time datetime={post.data.pubDate}>{formattedDate}</time>
      </p>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <article class="blog-content">
      <Content />
    </article>
  </main>
</Layout>

<style>
  .blog-post-container {
    max-width: 800px;
    margin: 2rem auto; /* Centers the container and adds top/bottom margin */
    padding: 0 1rem; /* Adds 1rem padding on left and right */
  }

  .blog-post-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--prls-text-tertiary, #ccc);
    padding-bottom: 1rem;
  }

  .blog-post-header h1 {
    font-family: var(--font-heading, serif);
    font-size: clamp(2.2rem, 6vw, 3rem); /* Responsive font size for main title */
    color: var(--prls-text-primary, #333);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .blog-post-header .meta {
    font-size: 0.9rem;
    color: var(--prls-text-secondary, #555);
    margin-bottom: 0.5rem;
  }

  .blog-post-header .tags {
    margin-top: 1rem;
  }

  .blog-post-header .tag {
    display: inline-block;
    background-color: var(--prls-main-surface-secondary, #e0e0e0);
    color: var(--prls-text-primary, #333);
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.8rem;
    margin-right: 0.5rem;
    margin-bottom: 0.5rem;
    text-decoration: none;
  }

  .blog-content {
    /* Styles for the main article content rendered from Markdown */
  }

  .blog-content h2,
  .blog-content h3,
  .blog-content h4,
  .blog-content h5,
  .blog-content h6 {
    font-family: var(--font-heading, serif); /* Use heading font */
    font-weight: var(--font-weight-bold); /* Ensure headings are bold */
    color: var(--prls-text-primary, #333);
    margin-top: 2em;
    margin-bottom: 1em;
    line-height: 1.3;
  }

  .blog-content h2 {
    font-size: clamp(2.2rem, 6vw, 3rem); /* Further increased font size for H2 */
    border-bottom: 1px solid var(--prls-main-surface-secondary, #eee);
    padding-bottom: 0.3em;
  }

  .blog-content h3 {
    font-size: clamp(1.9rem, 5vw, 2.5rem); /* Further increased font size for H3 */
  }

  .blog-content h4 {
    font-size: clamp(1.6rem, 4vw, 2rem); /* Further increased font size for H4 */
  }

  .blog-content p {
    margin-bottom: 1.5em;
    line-height: var(--line-height-body, 1.6);
    color: var(--prls-text-primary, #333);
    font-family: var(--font-body, sans-serif); /* Ensure body font is applied */
  }

  .blog-content a {
    color: var(--prls-text-secondary, #007bff);
    text-decoration: underline;
    text-decoration-color: var(--prls-main-surface-secondary, #007bff);
    text-decoration-thickness: 2px;
    transition: color 0.2s ease-in-out, text-decoration-color 0.2s ease-in-out;
  }

  .blog-content a:hover {
    color: var(--prls-text-primary, #0056b3);
    text-decoration-color: var(--prls-text-primary, #0056b3);
  }

  .blog-content ul,
  .blog-content ol {
    margin-bottom: 1.5em;
    padding-left: 2em; /* Indent lists */
  }

  .blog-content li {
    margin-bottom: 0.75em;
  }

  .blog-content blockquote {
    margin: 1.5em 0;
    padding: 1em 1.5em;
    background-color: var(--prls-main-surface-secondary, #f9f9f9);
    border-left: 5px solid var(--prls-text-secondary, #ccc);
    border-radius: 4px;
    font-style: italic;
    color: var(--prls-text-primary, #333);
  }

  .blog-content blockquote p {
    margin-bottom: 0;
  }

  .blog-content pre {
    background-color: #2d2d2d; /* Dark background for code blocks */
    color: #f8f8f2; /* Light text for code blocks */
    padding: 1em;
    margin-bottom: 1.5em;
    overflow-x: auto; /* Allow horizontal scrolling for long code lines */
    border-radius: 4px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9em;
  }

  .blog-content code { /* Inline code */
    background-color: var(--prls-main-surface-secondary, #e0e0e0);
    color: var(--prls-text-primary, #333);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 0.9em;
  }

  .blog-content pre code { /* Code inside pre blocks */
    background-color: transparent;
    padding: 0;
    border-radius: 0;
    color: inherit; /* Inherit color from pre */
  }

  .blog-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5em;
    font-size: 0.9em;
  }

  .blog-content th,
  .blog-content td {
    border: 1px solid var(--prls-text-secondary, #5d5d5d); /* Using a darker gray for table borders */
    padding: 0.75em;
    text-align: left;
  }

  .blog-content th {
    background-color: var(--prls-main-surface-secondary, #f0f0f0);
    font-weight: var(--font-weight-bold, bold);
    font-family: var(--font-heading, serif);
  }

  .blog-content hr {
    border: 0;
    height: 1px;
    background-color: var(--prls-text-tertiary, #ccc);
    margin: 2em 0;
  }

  .blog-content img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5em auto;
    border-radius: 4px;
  }
</style>
