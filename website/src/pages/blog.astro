---
import Layout from '../layouts/Layout.astro';
import '../styles/blog.css'; // Ensure this is imported for page-specific styles

const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const pageTitle = "Blog";

// Helper to format date
function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<Layout title={pageTitle}>
  <div class="blog-list-container">
    <h1>{pageTitle}</h1>
    <ul class="post-list">
      {allPosts.map((post: any) => (
        <li class="post-entry">
          <a href={post.url} class="post-title-link">
            <h2>{post.frontmatter.title}</h2>
          </a>
          <p class="post-meta">
            Published on <time datetime={post.frontmatter.date}>{formatDate(post.frontmatter.date)}</time>
            {post.frontmatter.author && ` by ${post.frontmatter.author}`}
          </p>
          {post.frontmatter.description && (
            <p class="post-description">{post.frontmatter.description}</p>
          )}
          <a href={post.url} class="read-more-link">Read more &rarr;</a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
